# ============================================================
# LoveTrack — Environment Variables (EXAMPLE)
# ------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
#
# WHAT LIVES HERE, AND WHAT DOES NOT
#
# Only two kinds of value belong in this file:
#
#   1. Secrets — API keys, the service-role key, the cron secret.
#      A secret in a database table an admin can read turns every admin
#      session into a way to exfiltrate it, and puts it in every backup.
#
#   2. Deployment facts — URLs and connection details needed before a
#      database connection exists.
#
# Everything else is configured in the admin panel at /admin/settings:
# accuracy limits, risk thresholds and signal weights, nonce lifetime,
# signed-URL lifetime, lunch clip limits, and data retention. Those are
# product decisions, not deployment facts, and changing one should not
# need a redeploy. Every change is written to the audit log.
#
# Reminder times are per-user, in each user's own Settings.
# ============================================================

# ---------- App (deployment facts) ----------
# Public base URL — used in emails, redirects and link previews.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LoveTrack

# ---------- Supabase ----------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses row level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Resend ----------
# Dashboard → API Keys
RESEND_API_KEY=
# Must be a verified sending domain. A subdomain such as send.example.com
# keeps transactional reputation separate from any personal mail on the
# root domain, and avoids clashing with it later.
RESEND_FROM_EMAIL=LoveTrack <noreply@send.example.com>

# ---------- Security ----------
# 32+ random characters. Salts the IP hash stored against each capture —
# without a salt the IPv4 space is small enough to brute-force in seconds.
NONCE_SECRET=
# Shared secret for the reminder cron. The endpoint refuses to run at all
# when this is unset, rather than defaulting to permissive.
CRON_SECRET=

# ---------- Cloudflare R2 (optional, Phase 12) ----------
# Media currently lives in Supabase Storage. These are for the move to R2,
# which the media layer is written to accommodate.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lovetrack-media
# S3-compatible endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ---------- E2E testing (local only) ----------
# Create these with:
#   node scripts/seed-e2e-user.mjs
#   node scripts/seed-e2e-partner.mjs
# Playwright's signed-in tests skip themselves when they are unset.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_PARTNER_EMAIL=
E2E_PARTNER_PASSWORD=
