# ============================================================
# LoveTrack — Environment Variables (EXAMPLE)
# ------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# ============================================================

# ---------- App ----------
# Public base URL of the app (used in emails, redirects, signed links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LoveTrack

# ---------- Supabase (Phase 2) ----------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never expose to the browser, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Cloudflare R2 (Phase 5) ----------
# Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lovetrack-media
# S3-compatible endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Signed URL lifetime in seconds (evidence media stays private)
R2_SIGNED_URL_TTL_SECONDS=300

# ---------- Resend (Phase 6) ----------
# Dashboard → API Keys
RESEND_API_KEY=
# Must be a verified sending domain/address
RESEND_FROM_EMAIL=LoveTrack <noreply@example.com>

# ---------- Security ----------
# 32+ char random string — used for nonce/session signing
NONCE_SECRET=
# Comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Verification defaults (overridable via system_settings table) ----------
# NOTE: There is NO fixed geofence. Check-in/out is allowed from ANYWHERE.
# What matters is that the reported location is GENUINE and ACCURATE.
#
# Reject submissions with worse GPS accuracy than this (metres)
MAX_LOCATION_ACCURACY_METERS=100
# Flag (not reject) submissions above this accuracy as low-confidence
WARN_LOCATION_ACCURACY_METERS=50
# Implausible travel speed between two consecutive captures (km/h) -> suspicious
MAX_PLAUSIBLE_SPEED_KMH=900
# Require a fresh fix: reject GPS readings older than this (seconds)
MAX_LOCATION_AGE_SECONDS=30
# Attendance nonce validity window (seconds)
NONCE_TTL_SECONDS=180
# Lunch proof video constraints
LUNCH_VIDEO_MIN_SECONDS=5
LUNCH_VIDEO_MAX_SECONDS=20
LUNCH_VIDEO_MAX_BYTES=8000000

# ---------- Cron (Phase 6) ----------
# Shared secret so only Cloudflare Cron can trigger reminder endpoints
CRON_SECRET=
# Daily reminder time, 24h HH:MM in IST
REMINDER_TIME=20:30
