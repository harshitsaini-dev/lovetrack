{
  "name": "lovetrack",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:headless": "cross-env HEADED=0 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:reset": "node scripts/reset-test-data.mjs",
    "verify:pairing": "node scripts/verify-pairing-rls.mjs",
    "verify:attendance": "node scripts/verify-attendance.mjs",
    "verify:lunch": "node scripts/verify-lunch.mjs",
    "verify:leave": "node scripts/verify-leave.mjs",
    "verify:partner": "node scripts/verify-partner-activity.mjs",
    "verify:retention": "node scripts/verify-retention.mjs",
    "verify:admin": "node scripts/verify-admin.mjs",
    "verify:hardening": "node scripts/verify-hardening.mjs",
    "verify:otp": "node scripts/verify-otp-auth.mjs",
    "verify:media": "node scripts/verify-media-and-delete.mjs",
    "verify:all": "npm run verify:pairing && npm run verify:attendance && npm run verify:lunch && npm run verify:leave && npm run verify:partner && npm run verify:retention && npm run verify:admin && npm run verify:hardening && npm run verify:otp && npm run verify:media",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "unrs-resolver@1.12.2": true
  }
}
